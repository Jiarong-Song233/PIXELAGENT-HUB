      "path": "index.html",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pixel Traffic Counter</title>\n  <style>\n    [hidden] {\n      display: none !important;\n    }\n\n    :root {\n      --bg-color: #1a1c23;\n      --card-bg: #282c37;\n      --border-color: #0d0e12;\n      --text-main: #f3f4f6;\n      --text-muted: #9ca3af;\n      --car-color: #3b82f6;\n      --bus-color: #f59e0b;\n      --bike-color: #10b981;\n      --undo-color: #ef4444;\n      --focus-ring: #ffffff;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: var(--bg-color);\n      background-image: \n        linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);\n      background-size: 20px 20px;\n      color: var(--text-main);\n      font-family: 'Courier New', Courier, monospace, system-ui, sans-serif;\n      font-size: 16px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      min-height: 100vh;\n      padding: 16px;\n    }\n\n    .counter-card {\n      background-color: var(--card-bg);\n      width: 100%;\n      max-width: 480px;\n      border: 4px solid var(--border-color);\n      box-shadow: 8px 8px 0px var(--border-color);\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n    }\n\n    header {\n      text-align: center;\n      border-bottom: 4px solid var(--border-color);\n      padding-bottom: 12px;\n    }\n\n    h1 {\n      font-size: 1.5rem;\n      letter-spacing: 1px;\n      text-transform: uppercase;\n      color: var(--text-main);\n      margin-bottom: 4px;\n    }\n\n    .subtitle {\n      font-size: 1rem;\n      color: var(--text-muted);\n    }\n\n    .total-panel {\n      background: var(--border-color);\n      padding: 16px;\n      border: 2px solid #3f4454;\n      text-align: center;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    .total-label {\n      font-size: 1rem;\n      letter-spacing: 1px;\n      color: var(--text-muted);\n      text-transform: uppercase;\n    }\n\n    .total-value {\n      font-size: 2.2rem;\n      font-weight: bold;\n      color: #38bdf8;\n    }\n\n    .actions-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 12px;\n    }\n\n    .btn {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      font-family: inherit;\n      font-size: 1rem;\n      font-weight: bold;\n      text-transform: uppercase;\n      padding: 14px 8px;\n      color: #ffffff;\n      border: 3px solid var(--border-color);\n      box-shadow: 4px 4px 0px var(--border-color);\n      cursor: pointer;\n      outline: none;\n      transition: transform 0.05s ease, box-shadow 0.05s ease;\n      user-select: none;\n    }\n\n    .btn:hover:not(:disabled) {\n      filter: brightness(1.1);\n    }\n\n    .btn:focus-visible {\n      outline: 3px solid var(--focus-ring);\n      outline-offset: 2px;\n    }\n\n    .btn:active:not(:disabled) {\n      transform: translate(3px, 3px);\n      box-shadow: 1px 1px 0px var(--border-color);\n    }\n\n    .btn:disabled {\n      opacity: 0.45;\n      cursor: not-allowed;\n      filter: grayscale(0.7);\n      box-shadow: none;\n      transform: translate(2px, 2px);\n    }\n\n    .btn-car {\n      background-color: var(--car-color);\n    }\n\n    .btn-bus {\n      background-color: var(--bus-color);\n    }\n\n    .btn-bike {\n      background-color: var(--bike-color);\n    }\n\n    .btn-undo {\n      background-color: var(--undo-color);\n      width: 100%;\n      padding: 12px;\n      font-size: 1.05rem;\n    }\n\n    .pixel-art {\n      image-rendering: pixelated;\n      display: block;\n      width: 32px;\n      height: 32px;\n    }\n\n    .stats-panel {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n      background-color: rgba(13, 14, 18, 0.4);\n      border: 2px solid var(--border-color);\n      padding: 14px;\n    }\n\n    .stat-row {\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    .stat-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      font-size: 1rem;\n      font-weight: bold;\n    }\n\n    .stat-header.car { color: #60a5fa; }\n    .stat-header.bus { color: #fbbf24; }\n    .stat-header.bike { color: #34d399; }\n\n    .bar-track {\n      height: 12px;\n      background-color: var(--border-color);\n      border: 2px solid #374151;\n      overflow: hidden;\n    }\n\n    .bar-fill {\n      height: 100%;\n      width: 0%;\n      transition: width 0.15s ease-out;\n    }\n\n    .bar-car { background-color: var(--car-color); }\n    .bar-bus { background-color: var(--bus-color); }\n    .bar-bike { background-color: var(--bike-color); }\n\n    .log-feedback {\n      font-size: 0.9rem;\n      text-align: center;\n      color: var(--text-muted);\n      min-height: 1.2em;\n    }\n\n    @media (max-width: 400px) {\n      .counter-card {\n        padding: 16px;\n        gap: 16px;\n      }\n      .btn {\n        padding: 10px 4px;\n        font-size: 0.95rem;\n      }\n      .actions-grid {\n        gap: 8px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"counter-card\" role=\"region\" aria-label=\"Pixel Traffic Counter\">\n    <header>\n      <h1>Pixel Traffic</h1>\n      <div class=\"subtitle\">Vehicle Census Tracker</div>\n    </header>\n\n    <section class=\"total-panel\" aria-live=\"polite\">\n      <div class=\"total-label\">Total Count</div>\n      <div class=\"total-value\" id=\"totalCount\">0</div>\n    </section>\n\n    <section class=\"actions-grid\" aria-label=\"Add Vehicle Actions\">\n      <button type=\"button\" class=\"btn btn-car\" id=\"btnCar\" aria-label=\"Record Car\">\n        <canvas id=\"iconCar\" class=\"pixel-art\" width=\"16\" height=\"16\" aria-hidden=\"true\"></canvas>\n        <span>Car</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-bus\" id=\"btnBus\" aria-label=\"Record Bus\">\n        <canvas id=\"iconBus\" class=\"pixel-art\" width=\"16\" height=\"16\" aria-hidden=\"true\"></canvas>\n        <span>Bus</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-bike\" id=\"btnBike\" aria-label=\"Record Bike\">\n        <canvas id=\"iconBike\" class=\"pixel-art\" width=\"16\" height=\"16\" aria-hidden=\"true\"></canvas>\n        <span>Bike</span>\n      </button>\n    </section>\n\n    <section class=\"stats-panel\" aria-label=\"Traffic Statistics\">\n      <div class=\"stat-row\">\n        <div class=\"stat-header car\">\n          <span>Car: <span id=\"carCount\">0</span></span>\n          <span id=\"carPercent\">0.0%</span>\n        </div>\n        <div class=\"bar-track\" aria-hidden=\"true\">\n          <div class=\"bar-fill bar-car\" id=\"carBar\"></div>\n        </div>\n      </div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-header bus\">\n          <span>Bus: <span id=\"busCount\">0</span></span>\n          <span id=\"busPercent\">0.0%</span>\n        </div>\n        <div class=\"bar-track\" aria-hidden=\"true\">\n          <div class=\"bar-fill bar-bus\" id=\"busBar\"></div>\n        </div>\n      </div>\n\n      <div class=\"stat-row\">\n        <div class=\"stat-header bike\">\n          <span>Bike: <span id=\"bikeCount\">0</span></span>\n          <span id=\"bikePercent\">0.0%</span>\n        </div>\n        <div class=\"bar-track\" aria-hidden=\"true\">\n          <div class=\"bar-fill bar-bike\" id=\"bikeBar\"></div>\n        </div>\n      </div>\n    </section>\n\n    <section>\n      <button type=\"button\" class=\"btn btn-undo\" id=\"btnUndo\" disabled aria-label=\"Undo last count\">\n        Undo Last Entry\n      </button>\n    </section>\n\n    <div class=\"log-feedback\" id=\"statusMsg\" aria-live=\"polite\">Ready to count.</div>\n  </main>\n\n  <script>\n    (function () {\n      // State Management\n      var counts = {\n        car: 0,\n        bus: 0,\n        bike: 0\n      };\n      var history = [];\n\n      // DOM Element Cache\n      var totalEl = document.getElementById('totalCount');\n      var carCountEl = document.getElementById('carCount');\n      var carPercentEl = document.getElementById('carPercent');\n      var carBarEl = document.getElementById('carBar');\n\n      var busCountEl = document.getElementById('busCount');\n      var busPercentEl = document.getElementById('busPercent');\n      var busBarEl = document.getElementById('busBar');\n\n      var bikeCountEl = document.getElementById('bikeCount');\n      var bikePercentEl = document.getElementById('bikePercent');\n      var bikeBarEl = document.getElementById('bikeBar');\n\n      var btnCar = document.getElementById('btnCar');\n      var btnBus = document.getElementById('btnBus');\n      var btnBike = document.getElementById('btnBike');\n      var btnUndo = document.getElementById('btnUndo');\n      var statusEl = document.getElementById('statusMsg');\n\n      // Draw Pixel Icons on Canvas (16x16 grid)\n      function drawPixelArt(canvasId, pixels, palette) {\n        var canvas = document.getElementById(canvasId);\n        if (!canvas || !canvas.getContext) return;\n        var ctx = canvas.getContext('2d');\n        ctx.clearRect(0, 0, 16, 16);\n        for (var y = 0; y < 16; y++) {\n          for (var x = 0; x < 16; x++) {\n            var char = (pixels[y] && pixels[y][x]) || '.';\n            if (char !== '.' && palette[char]) {\n              ctx.fillStyle = palette[char];\n              ctx.fillRect(x, y, 1, 1);\n            }\n          }\n        }\n      }\n\n      function initIcons() {\n        var carMatrix = [\n          '................',\n          '................',\n          '.....XXXXXX.....',\n          '....XGGGGGGX....',\n          '....XGGGGGGX....',\n          '..XXXXXXXXXXXX..',\n          '..XBBBBBBBBBBX..',\n          '..XBBBBBBBBBBX..',\n          '..XXXXXXXXXXXX..',\n          '...XWWX....XWWX.',\n          '...XXXX....XXXX.',\n          '................',\n          '................',\n          '................',\n          '................',\n          '................'\n        ];\n        drawPixelArt('iconCar', carMatrix, {\n          'X': '#0d0e12',\n          'G': '#93c5fd',\n          'B': '#3b82f6',\n          'W': '#ffffff'\n        });\n\n        var busMatrix = [\n          '................',\n          '..XXXXXXXXXXXX..',\n          '..XYYYYYYYYYYX..',\n          '..XYGWYGWWGYGX..',\n          '..XYGWYGWWGYGX..',\n          '..XYYYYYYYYYYX..',\n          '..XXXXXXXXXXXX..',\n          '..XYYYYYYYYYYX..',\n          '..XXXXXXXXXXXX..',\n          '...XWWX....XWWX.',\n          '...XXXX....XXXX.',\n          '................',\n          '................',\n          '................',\n          '................',\n          '................'\n        ];\n        drawPixelArt('iconBus', busMatrix, {\n          'X': '#0d0e12',\n          'Y': '#f59e0b',\n          'G': '#1e293b',\n          'W': '#ffffff'\n        });\n\n        var bikeMatrix = [\n          '................',\n          '......XX........',\n          '.......X........',\n          '.....XXXX.......',\n          '....X..X..X.....',\n          '....X..X...X....',\n          '..XXXX.X..XXXX..',\n          '.X....XX.X....X.',\n          '.X.XX..X.X.XX.X.',\n          '.X....XX.X....X.',\n          '..XXXX....XXXX..',\n          '................',\n          '................',\n          '................',\n          '................',\n          '................'\n        ];\n        drawPixelArt('iconBike', bikeMatrix, {\n          'X': '#10b981',\n          'W': '#ffffff'\n        });\n      }\n\n      // Render / Update Display\n      function render() {\n        var total = counts.car + counts.bus + counts.bike;\n        totalEl.textContent = total;\n\n        var carPct = total > 0 ? (counts.car / total) * 100 : 0;\n        var busPct = total > 0 ? (counts.bus / total) * 100 : 0;\n        var bikePct = total > 0 ? (counts.bike / total) * 100 : 0;\n\n        carCountEl.textContent = counts.car;\n        carPercentEl.textContent = carPct.toFixed(1) + '%';\n        carBarEl.style.width = carPct + '%';\n\n        busCountEl.textContent = counts.bus;\n        busPercentEl.textContent = busPct.toFixed(1) + '%';\n        busBarEl.style.width = busPct + '%';\n\n        bikeCountEl.textContent = counts.bike;\n        bikePercentEl.textContent = bikePct.toFixed(1) + '%';\n        bikeBarEl.style.width = bikePct + '%';\n\n        btnUndo.disabled = history.length === 0;\n      }\n\n      // Action Handlers\n      function addVehicle(type) {\n        counts[type] += 1;\n        history.push(type);\n        var label = type.charAt(0).toUpperCase() + type.slice(1);\n        statusEl.textContent = 'Added 1 ' + label + '.';\n        render();\n      }\n\n      function undo() {\n        if (history.length === 0) return;\n        var lastType = history.pop();\n        if (counts[lastType] > 0) {\n          counts[lastType] -= 1;\n        }\n        var label = lastType.charAt(0).toUpperCase() + lastType.slice(1);\n        statusEl.textContent = 'Undid last ' + label + '.';\n        render();\n      }\n\n      // Event Listeners\n      btnCar.addEventListener('click', function () {\n        addVehicle('car');\n      });\n\n      btnBus.addEventListener('click', function () {\n        addVehicle('bus');\n      });\n\n      btnBike.addEventListener('click', function () {\n        addVehicle('bike');\n      });\n\n      btnUndo.addEventListener('click', function () {\n        undo();\n      });\n\n      // Initialize app\n      initIcons();\n      render();\n    })();\n  </script>\n</body>\n</html>\n",
      "description": "Single-page HTML document containing the structure, CSS styling, and JavaScript logic for the pixel traffic counter application."
    },
