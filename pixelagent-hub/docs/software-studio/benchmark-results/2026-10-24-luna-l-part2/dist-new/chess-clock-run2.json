  "files": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Pixel Chess Clock</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"clock.js\" defer></script>\n</head>\n<body>\n  <main class=\"card\" aria-labelledby=\"title\">\n    <p class=\"eyebrow\">TWO PLAYER · 5 MINUTES</p>\n    <h1 id=\"title\">Pixel Chess Clock</h1>\n    <p class=\"hint\" id=\"status\" aria-live=\"polite\">White to move</p>\n\n    <section class=\"clocks\" aria-label=\"Player clocks\">\n      <button class=\"clock white active\" id=\"white-clock\" type=\"button\" aria-label=\"White clock, 5 minutes remaining. Tap to start White's turn.\">\n        <span class=\"player\">WHITE</span>\n        <span class=\"time\" id=\"white-time\">5:00</span>\n      </button>\n      <button class=\"clock black\" id=\"black-clock\" type=\"button\" aria-label=\"Black clock, 5 minutes remaining. Tap to start Black's turn.\">\n        <span class=\"player\">BLACK</span>\n        <span class=\"time\" id=\"black-time\">5:00</span>\n      </button>\n    </section>\n\n    <p id=\"flag\" class=\"flag\" role=\"status\" aria-live=\"assertive\" hidden>Flag!</p>\n    <button id=\"pause\" class=\"pause\" type=\"button\" aria-pressed=\"false\">Pause</button>\n    <p class=\"footnote\">Tap or press Enter on the side whose turn it is.</p>\n  </main>\n</body>\n</html>\n",
      "description": "Accessible, offline chess-clock interface."
    },
    {
      "path": "style.css",
      "content": "* { box-sizing: border-box; }\n[hidden] { display: none !important; }\n:root { color-scheme: dark; font-family: system-ui, sans-serif; background: #17221f; color: #f4ecd9; }\nbody { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 20px; background: radial-gradient(ellipse at top, #344a3d 0%, #17221f 68%); }\n.card { width: min(100%, 620px); padding: clamp(22px, 6vw, 42px); text-align: center; border: 4px solid #d4a85c; background: #24342c; box-shadow: 8px 8px 0 #101713; }\n.eyebrow { margin: 0 0 8px; color: #d4a85c; font-size: 16px; font-weight: 800; letter-spacing: .14em; }\nh1 { margin: 0; font-size: clamp(27px, 7vw, 40px); line-height: 1.15; }\n.hint { min-height: 26px; margin: 14px 0 24px; color: #c9d5c6; font-size: 18px; }\n.clocks { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\n.clock { min-width: 0; min-height: 160px; display: flex; flex-direction: column; justify-content: center; gap: 12px; border: 4px solid transparent; cursor: pointer; font: inherit; transition: transform .12s, filter .12s, border-color .12s; }\n.clock.white { background: #e8dfc9; color: #24342c; }\n.clock.black { background: #455b4c; color: #f4ecd9; }\n.clock.active { border-color: #d4a85c; }\n.clock:hover { filter: brightness(1.08); }\n.clock:active { transform: translateY(3px); }\n.clock:focus-visible, .pause:focus-visible { outline: 4px solid #f4ecd9; outline-offset: 4px; }\n.player { font-size: 16px; font-weight: 800; letter-spacing: .12em; }\n.time { font-variant-numeric: tabular-nums; font-size: clamp(38px, 11vw, 58px); font-weight: 800; line-height: 1; }\n.clock.inactive { opacity: .72; }\n.clock:disabled { cursor: default; }\n.pause { min-width: 140px; margin-top: 24px; padding: 12px 24px; border: 3px solid #d4a85c; background: #d4a85c; color: #17221f; cursor: pointer; font: inherit; font-size: 18px; font-weight: 800; }\n.pause:hover { background: #f0c778; border-color: #f0c778; }\n.pause:active { transform: translateY(2px); }\n.pause[aria-pressed=\"true\"] { background: #24342c; color: #f4ecd9; }\n.flag { margin: 18px 0 0; color: #f0c778; font-size: 32px; font-weight: 900; letter-spacing: .08em; }\n.footnote { margin: 22px 0 0; color: #c9d5c6; font-size: 16px; }\n@media (max-width: 420px) { .clocks { gap: 9px; } .clock { min-height: 140px; } }\n",
      "description": "Responsive pixel-inspired styling with clear interaction states."
    },
    {
      "path": "clock.js",
      "content": "const INITIAL_MS = 5 * 60 * 1000;\nconst remaining = { white: INITIAL_MS, black: INITIAL_MS };\nconst buttons = { white: document.querySelector('#white-clock'), black: document.querySelector('#black-clock') };\nconst displays = { white: document.querySelector('#white-time'), black: document.querySelector('#black-time') };\nconst status = document.querySelector('#status');\nconst flag = document.querySelector('#flag');\nconst pauseButton = document.querySelector('#pause');\nlet active = 'white';\nlet paused = false;\nlet flagged = false;\nlet lastTick = performance.now();\n\nfunction format(ms) {\n  const seconds = Math.ceil(ms / 1000);\n  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;\n}\n\nfunction render() {\n  for (const side of ['white', 'black']) {\n    displays[side].textContent = format(remaining[side]);\n    buttons[side].classList.toggle('active', !paused && !flagged && side === active);\n    buttons[side].classList.toggle('inactive', paused || flagged || side !== active);\n    buttons[side].setAttribute('aria-label', `${side === 'white' ? 'White' : 'Black'} clock, ${format(remaining[side])} remaining. ${side === active && !paused && !flagged ? 'Tap to pass the turn.' : 'Tap to start this turn.'}`);\n    buttons[side].disabled = flagged;\n  }\n  status.textContent = flagged ? `${active === 'white' ? 'White' : 'Black'} ran out of time` : paused ? 'Clock paused' : `${active === 'white' ? 'White' : 'Black'} to move`;\n  pauseButton.textContent = paused ? 'Clock paused' : 'Pause';\n  pauseButton.setAttribute('aria-pressed', String(paused));\n}\n\nfunction tick(now) {\n  const elapsed = now - lastTick;\n  lastTick = now;\n  if (!paused && !flagged) {\n    remaining[active] = Math.max(0, remaining[active] - elapsed);\n    if (remaining[active] === 0) {\n      flagged = true;\n      flag.hidden = false;\n    }\n    render();\n  }\n  requestAnimationFrame(tick);\n}\n\nfor (const side of ['white', 'black']) {\n  buttons[side].addEventListener('click', () => {\n    if (flagged || paused) return;\n    active = side;\n    render();\n  });\n}\n\npauseButton.addEventListener('click', () => {\n  if (flagged) return;\n  paused = !paused;\n  lastTick = performance.now();\n  render();\n});\n\nrender();\nrequestAnimationFrame(tick);\n",
      "description": "Turn switching, pause/resume, live countdown and flag behavior."
    },
