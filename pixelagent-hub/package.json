{
  "name": "pixelagent-hub",
  "version": "2.9.0",
  "description": "A lightweight, observable multi-agent orchestration framework in TypeScript with multi-provider LLM support",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "pixelagent": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "src",
    "config",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiarong-Song233/PIXELAGENT-HUB.git"
  },
  "bugs": {
    "url": "https://github.com/Jiarong-Song233/PIXELAGENT-HUB/issues"
  },
  "homepage": "https://github.com/Jiarong-Song233/PIXELAGENT-HUB#readme",
  "scripts": {
    "build": "tsc",
    "build:all": "npm run build && npm run ui:build",
    "start": "node dist/src/web/server.js --dashboard",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:dashboard": "node scripts/smoke-dashboard.mjs",
    "portfolio:demo": "node scripts/portfolio-demo.mjs",
    "replay:export": "tsx scripts/export-replay.ts",
    "checks:replay": "tsx scripts/replay-checks.ts",
    "test": "node scripts/test.mjs",
    "dev": "tsx examples/content-pipeline.ts",
    "example:pipeline": "tsx examples/content-pipeline.ts",
    "example:code-review": "tsx examples/code-review.ts",
    "example:debate": "tsx examples/debate.ts",
    "example:vote": "tsx examples/vote.ts",
    "example:company": "tsx examples/company-mode.ts",
    "records:api": "tsx src/web/server.ts",
    "studio:create": "tsx scripts/create-software.ts",
    "studio:doctor": "tsx scripts/doctor-software.ts",
    "studio:preview": "tsx scripts/preview-software.ts",
    "studio:benchmark": "tsx scripts/benchmark-software.ts",
    "studio:benchmark:report": "tsx scripts/report-software-benchmark.ts",
    "studio:benchmark:browser": "tsx scripts/benchmark-browser-checks.ts",
    "studio:benchmark:series": "tsx scripts/report-benchmark-series.ts",
    "load:test": "node scripts/load-test.js",
    "ui:dev": "npm --prefix dashboard run dev",
    "ui:build": "npm --prefix dashboard run build",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "codex:chat": "tsx scripts/codex-chat-server.ts",
    "agy:chat": "tsx scripts/codex-chat-server.ts --backend agy"
  },
  "keywords": [
    "agent",
    "multi-agent",
    "orchestration",
    "ai",
    "llm",
    "typescript",
    "pipeline",
    "debate",
    "openai",
    "anthropic",
    "claude"
  ],
  "author": "Kclaw",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "ajv": "^8.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.1",
    "playwright": "^1.64.0",
    "zod": "^4.4.1"
  }
}
